{
  "name": "proofboard",
  "version": "0.1.0",
  "private": true,
  "description": "Próbanyák-tervező és -szimulátor: szekciós/pontraszteres/csíkos panelek, hidak, vezetékek, útvonalkereső, egyenáramú szimuláció.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.8.3",
    "vite": "~6.3.5",
    "vite-plugin-singlefile": "~2.2.0",
    "vitest": "~3.1.4"
  }
}
